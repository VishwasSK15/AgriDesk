{
  "name": "agridesk",
  "version": "1.0.0",
  "description": "Offline-first Windows billing, inventory, GST invoicing and farmer Khata management software for agricultural retailers.",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "dev": "concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite\"",
    "start": "electron .",
    "start:qa": "cross-env AGRI_ENV=qa electron .",
    "dev:qa": "cross-env AGRI_ENV=qa concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite\"",
    "test:e2e": "cross-env AGRI_ENV=qa node test/e2e-ui-validation.js",
    "test:reset-qa": "node test/reset-qa-env.js",
    "test:acceptance": "node test/verify-acceptance-fixes.js",
    "test:full": "node test/verify-full-acceptance.js",
    "test:pdf": "electron test/verify-pdf-and-demo-init.js",
    "test:invoice-pdf": "electron test/verify-invoice-pdf-formatting.js"
  },
  "author": "VishwasSK15",
  "license": "MIT",
  "keywords": [
    "agriculture",
    "billing",
    "pos",
    "inventory",
    "offline-first",
    "gst",
    "electron"
  ],
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
